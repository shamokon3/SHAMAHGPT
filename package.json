
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>ShamahGPT</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#10101a;color:white;font-family:Arial,sans-serif}
.app{max-width:850px;margin:auto;height:100vh;display:flex;flex-direction:column;padding:16px}
header{display:flex;align-items:center;gap:12px;border-bottom:1px solid #302942;padding:12px}
.logo{background:#7655db;padding:13px;border-radius:13px;font-size:22px}
h2{margin:0;font-size:21px}
small{color:#aaa}
#chat{flex:1;overflow-y:auto;padding:15px}
.msg{padding:13px 16px;margin:12px 0;border-radius:15px;line-height:1.5;white-space:pre-wrap;overflow-wrap:anywhere}
.user{background:#6548b5;margin-left:12%;border-bottom-right-radius:4px}
.bot{background:#252436;margin-right:8%;border-bottom-left-radius:4px}
form{display:flex;gap:9px;padding:12px 0}
input{flex:1;min-width:0;background:#222132;color:white;border:1px solid #49405e;border-radius:14px;padding:16px;font-size:15px}
button{background:#7655db;color:white;border:0;border-radius:13px;padding:12px 19px;cursor:pointer;font-size:15px}
button:disabled{opacity:.5}
.tools{display:flex;justify-content:space-between;align-items:center;padding:8px;color:#999;font-size:12px}
</style>
</head>
<body>
<div class="app">
<header>
  <div class="logo">✦</div>
  <div>
    <h2>ShamahGPT</h2>
    <small>Your AI. Your world.</small>
  </div>
  <button onclick="newChat()" style="margin-left:auto">＋ New chat</button>
</header>

<div id="chat">
  <div class="msg bot">👋 Welcome to ShamahGPT! I'm ready to help you. What would you like to know?</div>
</div>

<div class="tools">
  <span>Powered by ShamahGPT AI</span>
  <span id="status">Ready</span>
</div>

<form id="form">
  <input id="question" placeholder="Message ShamahGPT..." autocomplete="off" required>
  <button id="send">➤</button>
</form>
</div>

<script>
const chat=document.getElementById("chat");
const form=document.getElementById("form");
const input=document.getElementById("question");
const send=document.getElementById("send");
const statusText=document.getElementById("status");
let messages=[];

function addMessage(text,role){
  const div=document.createElement("div");
  div.className="msg "+role;
  div.textContent=text;
  chat.appendChild(div);
  chat.scrollTop=chat.scrollHeight;
  return div;
}

function newChat(){
  messages=[];
  chat.innerHTML="";
  addMessage("👋 Welcome back! What can I help you with?","bot");
  statusText.textContent="Ready";
}

form.addEventListener("submit",async e=>{
  e.preventDefault();
  const question=input.value.trim();
  if(!question||send.disabled)return;

  input.value="";
  messages.push({role:"user",content:question});
  addMessage(question,"user");
  send.disabled=true;
  statusText.textContent="Thinking...";

  const loading=addMessage("ShamahGPT is thinking...","bot");

  try{
    const response=await fetch("/api/chat",{
      method:"POST",
      headers:{"Content-Type":"application/json"},
      body:JSON.stringify({messages})
    });

    const data=await response.json();
    if(!response.ok)throw new Error(data.error||"Request failed");

    loading.textContent=data.reply;
    messages.push({role:"assistant",content:data.reply});
    statusText.textContent="Ready";
  }catch(error){
    loading.textContent="Sorry! "+error.message;
    statusText.textContent="Error";
  }finally{
    send.disabled=false;
    input.focus();
    chat.scrollTop=chat.scrollHeight;
  }
});
</script>
</body>
</html>
